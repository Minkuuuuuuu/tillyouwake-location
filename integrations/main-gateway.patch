+def test_location_base_survives_app_reset_session_change(tmp_path, monkeypatch):
+    voice, posts, outcomes = _app_world(tmp_path, monkeypatch, last_used=None)
+    loc = _Loc(tmp_path, monkeypatch)
+    t0 = 100_000.0
+    loc.fix(0, t0)
+    st = _app({"first_seen_at": t0}, t0, tmp_path)
+    (tmp_path / "app" / "sessions" / "sessions.json").write_text(json.dumps(
+        {"agent:main:tillyouwake_app:dm:x": {"platform": "tillyouwake_app", "session_id": "A2"}}))
+    loc.fix(120, t0 + 60)  # reset is not a move; the base stays where it was
+    st = _app(st, t0 + 60, tmp_path)
+    assert st["session_id"] == "A2" and st["location"]["notified"]["latitude"] == 23.1 and not posts
+    loc.fix(210, t0 + 120)
+    st = _app(st, t0 + 120, tmp_path)
+    assert len(posts) == 1 and "约210米" in posts[0][1]
+
+
+# ── switch vs. move dispatch ordering (same flock as the App switch) ───────
+
+def _armed_move(tmp_path, monkeypatch):
+    """A world where the next tick picks a location move; returns (voice, posts, loc, state, t)."""
+    voice, posts, outcomes = _app_world(tmp_path, monkeypatch, last_used=None)
+    loc = _Loc(tmp_path, monkeypatch)
+    t0 = 100_000.0
+    loc.fix(0, t0)
+    st = _app({"first_seen_at": t0}, t0, tmp_path)
+    loc.fix(300, t0 + 60)
+    return voice, posts, loc, st, t0 + 60
+
+
+def _flip_during_awaits(monkeypatch, action):
+    """Run ``action`` between the move being chosen and the final dispatch (the
+    awaits on voice_busy / other_outlet_activity), like a switch write landing there."""
+    def other(*a, **k):
+        action()
+        return None
+    monkeypatch.setattr(pcc, "other_outlet_activity", other)
+
+
+def test_switch_off_after_move_chosen_never_posts(tmp_path, monkeypatch):
+    voice, posts, loc, st, now = _armed_move(tmp_path, monkeypatch)
+    _flip_during_awaits(monkeypatch, lambda: loc.set_config(False, 2))
+    st = _app(st, now, tmp_path)
+    assert posts == []
+    assert "inflight" not in st["location"] and st["location"]["notified"]["latitude"] == 23.1
+    assert st["last_reason"] == "location_switched" and not st.get("retry_at")
+
+
+def test_switch_off_on_after_move_chosen_drops_old_generation(tmp_path, monkeypatch):
+    voice, posts, loc, st, now = _armed_move(tmp_path, monkeypatch)
+    _flip_during_awaits(monkeypatch, lambda: loc.set_config(True, 2))
+    st = _app(st, now, tmp_path)
+    assert posts == [] and "inflight" not in st["location"]
+    assert st["last_reason"] == "location_switched"
+
+
+def test_move_dispatch_holds_the_switch_lock_until_posted(tmp_path, monkeypatch):
+    import fcntl
+    voice, posts, loc, st, now = _armed_move(tmp_path, monkeypatch)
+    lock_path = loc.cfg.with_name(".config.lock")
+    seen = []
+
+    def post(mid, text, **kw):
+        with open(lock_path, "a") as other:  # the App switch's view while the move is being handed over
+            try:
+                fcntl.flock(other, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                seen.append("switch_got_lock")
+            except BlockingIOError:
+                seen.append("switch_waits")
+        posts.append((mid, text))
+        return "queued"
+
+    monkeypatch.setattr(pcc, "post_app_round", post)
+    st = _app(st, now, tmp_path)
+    assert seen == ["switch_waits"] and len(posts) == 1
+    assert st["location"]["inflight"]["message_id"] == posts[0][0]  # handed over first: in flight, not revoked
+    with open(lock_path, "a") as other:
+        fcntl.flock(other, fcntl.LOCK_EX | fcntl.LOCK_NB)  # released afterwards: the switch proceeds
+
+
+def test_move_defers_while_switch_holds_lock(tmp_path, monkeypatch):
+    import fcntl
+    voice, posts, loc, st, now = _armed_move(tmp_path, monkeypatch)
+    monkeypatch.setattr(pcc, "LOCATION_LOCK_TIMEOUT", 0.0)
+    with open(loc.cfg.with_name(".config.lock"), "a") as held:
+        fcntl.flock(held, fcntl.LOCK_EX)
+        st = _app(st, now, tmp_path)
+    assert posts == [] and "inflight" not in st["location"]
+    assert st["last_reason"] == "location_switch_busy" and not st.get("retry_at")
+    st = _app(st, now + 60, tmp_path)  # next tick, switch done (still on): goes out
+    assert len(posts) == 1
