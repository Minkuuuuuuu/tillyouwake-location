+
+
+# ── location move wake (App text outlet) ────────────────────────────────────
+# Her latest location is collected by tillyouwake-location.service. The App
+# plugin shows it on every text turn; this only decides the extra wake when she
+# has moved ~200 m from the point the last move wake told 祂 about.
+
+LOCATION_CONFIG = Path("/etc/tillyouwake-location/config.json")
+LOCATION_STATE = Path("/var/lib/tillyouwake-location/latest.json")
+LOCATION_MOVE_METERS = 200.0
+LOCATION_COOLDOWN_SECONDS = 180.0
+LOCATION_FRESH_SECONDS = 300.0
+LOCATION_ACCURACY_METERS = 100.0
+_LOCATION_CRS_LABEL = {"wgs84": "WGS-84", "gcj02": "GCJ-02"}
+# The App switch (tillyouwake_app/location_control.update) writes config.json while
+# holding an exclusive flock on ".config.lock" beside it. A move wake is handed to
+# voice under the same lock after re-reading the config, so a switch-off either
+# lands before the hand-over (nothing is sent) or after it (the round is already in
+# flight and, as agreed, not revoked). Bounded waits on both holders: no deadlock.
+LOCATION_LOCK_TIMEOUT = 5.0
+LOCATION_POST_TIMEOUT = 3.0
+
+
+def _location_distance(a: dict[str, Any], b: dict[str, Any]) -> float:
+    import math
+    p1, p2 = math.radians(a["latitude"]), math.radians(b["latitude"])
+    h = (math.sin((p2 - p1) / 2) ** 2 + math.cos(p1) * math.cos(p2)
+         * math.sin(math.radians(b["longitude"] - a["longitude"]) / 2) ** 2)
+    return 2 * 6371008.8 * math.asin(min(1.0, math.sqrt(h)))
+
+
+def read_location(config_path: Path | None = None, state_path: Path | None = None) -> dict[str, Any] | None:
+    """``{"generation", "fix"}`` while location is switched on; ``None`` when off or unreadable.
+
+    ``fix`` is a sample of this generation/device/CRS, or ``None`` when none exists yet.
+    """
+    try:
+        config = json.loads(Path(config_path or LOCATION_CONFIG).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    if not isinstance(config, dict) or config.get("enabled") is not True or not isinstance(config.get("generation"), int):
+        return None
+    try:
+        snap = json.loads(Path(state_path or LOCATION_STATE).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        snap = None
+    fix = None
+    if (isinstance(snap, dict) and snap.get("generation") == config["generation"]
+            and snap.get("device_id") == config.get("device_id") and snap.get("source_crs") == config.get("source_crs")):
+        try:
+            fix = {"device_id": snap["device_id"], "source_crs": snap["source_crs"],
+                   "latitude": float(snap["latitude"]), "longitude": float(snap["longitude"]),
+                   "accuracy_m": float(snap["accuracy_m"]), "sampled_at": float(snap["sampled_at"])}
+        except (KeyError, TypeError, ValueError):
+            fix = None
+    return {"generation": config["generation"], "fix": fix}
+
+
+def location_check(state: dict[str, Any], latest: dict[str, Any] | None,
+                   now: float) -> tuple[dict[str, Any], dict[str, Any] | None, float]:
+    """Update the outlet's ``location`` sub-state; return (state, sample to announce or None, metres).
+
+    A new generation rebuilds the base but keeps ``last_wake_at`` so a quick
+    off/on can never beat the 180 s spacing. Only a fresh (≤300 s), accurate
+    (≤100 m) sample may set a base or count as movement; the first one only
+    sets the base. Ordinary turns never touch ``notified``.
+    """
+    if latest is None:
+        return state, None, 0.0
+    state = dict(state)
+    loc = dict(state.get("location") or {})
+    if loc.get("generation") != latest["generation"]:
+        loc = {"generation": latest["generation"], "last_wake_at": loc.get("last_wake_at")}
+    state["location"] = loc
+    fix = latest.get("fix")
+    if (not fix or not -30 <= now - fix["sampled_at"] <= LOCATION_FRESH_SECONDS
+            or fix["accuracy_m"] > LOCATION_ACCURACY_METERS):
+        return state, None, 0.0
+    base = loc.get("notified")
+    if (not isinstance(base, dict) or base.get("device_id") != fix["device_id"]
+            or base.get("source_crs") != fix["source_crs"]):
+        loc["notified"] = dict(fix)
+        return state, None, 0.0
+    meters = _location_distance(base, fix)
+    if meters < LOCATION_MOVE_METERS or now - float(loc.get("last_wake_at") or 0) < LOCATION_COOLDOWN_SECONDS:
+        return state, None, meters
+    return state, dict(fix), meters
+
+
+def location_settle(state: dict[str, Any], message_id: str, success: bool) -> dict[str, Any]:
+    """After the outlet's round finished: a successful move wake (NO_REPLY too) moves the base
+    to the sample it announced, only if that sample belongs to the current generation."""
+    loc = state.get("location")
+    if not isinstance(loc, dict) or not isinstance(loc.get("inflight"), dict):
+        return state
+    inflight = loc["inflight"]
+    if inflight.get("message_id") != message_id:
+        return state
+    loc = dict(loc)
+    loc.pop("inflight", None)
+    if success and inflight.get("generation") == loc.get("generation"):
+        loc["notified"] = dict(inflight["sample"])
+    return {**state, "location": loc}
+
+
+def location_message(settings: dict[str, Any], sample: dict[str, Any], meters: float) -> str:
+    when = dt.datetime.fromtimestamp(sample["sampled_at"], LOCAL_ZONE).strftime("%H:%M")
+    crs = _LOCATION_CRS_LABEL.get(sample["source_crs"], sample["source_crs"])
+    text = (f"[位置变化] 宝宝的位置相对上次通知的地点变化了约{round(meters)}米。"
+            f"事件采样：{when}，{sample['latitude']:.6f},{sample['longitude']:.6f}（{crs}）。"
+            "本轮位置上下文提供最新可用位置。")
+    return text + "\n" + settings["silence_hint"]
+
+
+def post_location_round(message_id: str, text: str, generation: int) -> str:
+    """Hand a move wake to voice under the switch lock.
+
+    Returns ``post_app_round``'s result, ``"switched"`` when location was switched
+    off or to another generation since the move was chosen, or ``"switch_busy"``
+    when the switch held the lock past the timeout (try again next tick).
+    """
+    try:
+        lock_file = open(Path(LOCATION_CONFIG).with_name(".config.lock"), "a")
+    except OSError:
+        return "switch_busy"
+    with lock_file:
+        deadline = time.monotonic() + LOCATION_LOCK_TIMEOUT
+        while True:
+            try:
+                fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                break
+            except BlockingIOError:
+                if time.monotonic() >= deadline:
+                    return "switch_busy"
+                time.sleep(0.05)
+        try:
+            latest = read_location()
+            if latest is None or latest["generation"] != generation:
+                return "switched"
+            return post_app_round(message_id, text, timeout=LOCATION_POST_TIMEOUT)
+        finally:
+            fcntl.flock(lock_file, fcntl.LOCK_UN)
