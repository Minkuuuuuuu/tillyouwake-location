+# ── location move wake (App text outlet) ────────────────────────────────────
+
+@pytest.fixture(autouse=True)
+def _no_real_location(tmp_path, monkeypatch):
+    monkeypatch.setattr(pcc, "LOCATION_CONFIG", tmp_path / "no-location-config.json")
+    monkeypatch.setattr(pcc, "LOCATION_STATE", tmp_path / "no-location-latest.json")
+
+
+class _Loc:
+    """Writes the config/latest.json pair the collector and App backend own."""
+
+    def __init__(self, tmp_path, monkeypatch, generation=1):
+        self.cfg, self.latest = tmp_path / "loc-config.json", tmp_path / "loc-latest.json"
+        monkeypatch.setattr(pcc, "LOCATION_CONFIG", self.cfg)
+        monkeypatch.setattr(pcc, "LOCATION_STATE", self.latest)
+        self.set_config(True, generation)
+
+    def set_config(self, enabled, generation):
+        self.generation = generation
+        self.cfg.write_text(json.dumps({"enabled": enabled, "generation": generation,
+                                        "device_id": "d1", "source_crs": "wgs84"}))
+
+    def fix(self, north_m, sampled_at, accuracy=20.0, generation=None):
+        self.latest.write_text(json.dumps({
+            "generation": self.generation if generation is None else generation, "device_id": "d1",
+            "source_crs": "wgs84", "latitude": 23.1 + north_m / 111195.0, "longitude": 113.3,
+            "accuracy_m": accuracy, "sampled_at": sampled_at}))
+
+
+def _latest(north_m, sampled_at, accuracy=20.0, generation=1, device="d1"):
+    return {"generation": generation, "fix": {"device_id": device, "source_crs": "wgs84",
+                                              "latitude": 23.1 + north_m / 111195.0, "longitude": 113.3,
+                                              "accuracy_m": accuracy, "sampled_at": sampled_at}}
+
+
+def _processing(voice, mid):
+    with sqlite3.connect(voice) as con:
+        con.execute("INSERT INTO messages VALUES (?, 'processing', NULL, NULL)", (mid,))
+
+
+def _done(voice, mid, reply):
+    with sqlite3.connect(voice) as con:
+        con.execute("UPDATE messages SET state='ready', reply_text=? WHERE id=?", (reply, mid))
+
+
+def test_location_check_rules():
+    now = 50_000.0
+    st, move, _ = pcc.location_check({}, _latest(0, now - 10), now)
+    assert move is None and st["location"]["notified"]["latitude"] == 23.1  # first fix: base only
+    assert pcc.location_check(st, _latest(199, now), now)[1] is None
+    st2, move, meters = pcc.location_check(st, _latest(200.5, now), now)
+    assert move is not None and 200 <= meters < 201
+    assert "notified" in st2["location"] and st2["location"]["notified"]["latitude"] == 23.1  # dispatch does not move base
+    # freshness 300/301 s, accuracy 100/101 m, future skew
+    assert pcc.location_check(st, _latest(500, now - 300), now)[1] is not None
+    assert pcc.location_check(st, _latest(500, now - 301), now)[1] is None
+    assert pcc.location_check(st, _latest(500, now, accuracy=100), now)[1] is not None
+    assert pcc.location_check(st, _latest(500, now, accuracy=101), now)[1] is None
+    assert pcc.location_check(st, _latest(500, now + 31), now)[1] is None
+    # cooldown 179/180 s from the last move dispatch
+    cooled = {**st, "location": {**st["location"], "last_wake_at": now - 179}}
+    assert pcc.location_check(cooled, _latest(500, now), now)[1] is None
+    cooled["location"]["last_wake_at"] = now - 180
+    assert pcc.location_check(cooled, _latest(500, now), now)[1] is not None
+    # another device re-bases silently; switched off leaves state untouched
+    st3, move, _ = pcc.location_check(st, _latest(900, now, device="d2"), now)
+    assert move is None and st3["location"]["notified"]["device_id"] == "d2"
+    assert pcc.location_check(st, None, now) == (st, None, 0.0)
+    # a new generation rebuilds the base but keeps the cooldown clock
+    st4, move, _ = pcc.location_check(cooled, _latest(900, now, generation=2), now)
+    assert move is None and st4["location"]["generation"] == 2
+    assert st4["location"]["notified"]["latitude"] > 23.1 and st4["location"]["last_wake_at"] == now - 180
+
