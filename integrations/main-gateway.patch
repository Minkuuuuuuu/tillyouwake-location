+def test_location_message_keeps_her_wording():
+    msg = pcc.location_message(_settings(), _latest(0, _sh("2026-10-03 18:05"))["fix"], 212.4)
+    assert msg == ("[位置变化] 宝宝的位置相对上次通知的地点变化了约212米。事件采样：18:05，23.100000,113.300000（WGS-84）。"
