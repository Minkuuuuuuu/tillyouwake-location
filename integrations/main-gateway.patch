+def test_location_move_wakes_settles_and_cools_down(tmp_path, monkeypatch):
+    voice, posts, outcomes = _app_world(tmp_path, monkeypatch, last_used=None)
+    loc = _Loc(tmp_path, monkeypatch)
+    t0 = 100_000.0
+    loc.fix(0, t0 - 5)
+    st = _app({"first_seen_at": t0}, t0, tmp_path)
+    assert not posts and st["location"]["notified"]["latitude"] == 23.1  # base only, no wake
+    loc.fix(250, t0 + 55)
+    st = _app(st, t0 + 60, tmp_path)
+    assert len(posts) == 1 and posts[0][1].startswith("[位置变化] 宝宝的位置相对上次通知的地点变化了约250米。")
+    assert st["last_kind"] == "location_move" and st["location"]["inflight"]["message_id"] == posts[0][0]
+    assert st["location"]["notified"]["latitude"] == 23.1
+    _processing(voice, posts[0][0])
+    # she keeps walking while 祂 thinks: nothing queued, the round is still inflight
+    loc.fix(600, t0 + 115)
+    st = _app(st, t0 + 120, tmp_path)
+    assert len(posts) == 1 and st["status"] == "inflight"
+    _done(voice, posts[0][0], "NO_REPLY\n她在走路，不吵她")
+    st = _app(st, t0 + 180, tmp_path)
+    assert outcomes[-1]["reason_code"] == "model_silent" and outcomes[-1]["kind"] == "location_move"
+    assert abs(st["location"]["notified"]["latitude"] - (23.1 + 250 / 111195.0)) < 1e-9  # announced sample, not the later one
+    assert "inflight" not in st["location"] and len(posts) == 1  # 180 s not yet passed since the wake at +60
+    st = _app(st, t0 + 240, tmp_path)
+    assert len(posts) == 2 and "约350米" in posts[1][1]  # merged to the newest point after the cooldown
+
