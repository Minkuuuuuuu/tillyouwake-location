@@ -15,7 +15,7 @@
   const state = { available: false, probed: false, probing: false, cursor: null, windowCursor: null, loading: false,
     retryTimer: 0, retryCount: 0, oldestAt: null, windowOldestAt: null, callRefreshTimer: 0,
     callInitialLoading: false, callRefreshPending: false, callRefreshLoading: false, lastCallPollAt: 0,
-    windowToken: 0 };
+    windowToken: 0, roundsLoading: false, roundsAgain: false };
 
   function scheduleProbe() {
     if (state.retryTimer || state.probed || document.hidden) return;
@@ -320,13 +320,54 @@
     } catch { /* the bubbles simply stay un-quotable until the next reconcile */ }
   }
 
+  // Rounds the service opens by itself (a proactive wake: heartbeat, location move, …) are not polled
+  // by this page. The service announces them on /events; then the newest rounds are read once and any
+  // reply not yet here is placed by its time. Read-only: nothing is sent or re-run.
+  async function refreshRecentRounds() {
+    if (!state.available || document.hidden || timeline.mode !== "latest") return;
+    if (state.roundsLoading) { state.roundsAgain = true; return; }  // a read already under way may predate it
+    state.roundsLoading = true;
+    try {
+      const nodes = build(pageOf(await chat.request("/messages?limit=10"))?.entries || []);
+      if (!nodes.length || timeline.mode !== "latest") return;
+      const follow = timeline.nearBottom?.();
+      for (const node of nodes) {
+        const time = Date.parse(node.dataset.created);
+        const next = Number.isFinite(time) && [...timeline.list.querySelectorAll(":scope > .chat-entry")]
+          .find(other => Date.parse(other.dataset.created) > time);
+        if (next) next.before(node);
+        else timeline.list.append(node);
+      }
+      timeline.paintDays?.();
+      if (follow) timeline.toLatest?.();
+    } catch { /* the next poll or a reload shows it */ }
+    finally {
+      state.roundsLoading = false;
+      if (state.roundsAgain) { state.roundsAgain = false; void refreshRecentRounds(); }
+    }
+  }
+
+  // One stream only while the page is visible; every (re)connect and every return reads once to catch up.
+  let events = null;
+  function openEvents() {
+    if (events || document.hidden || !state.available || chat.preview || typeof EventSource !== "function") return;
+    events = new EventSource("/voice-api/v1/events");
+    events.addEventListener("open", () => void refreshRecentRounds());
+    events.addEventListener("rounds", () => void refreshRecentRounds());
+  }
+  function closeEvents() { events?.close(); events = null; }
+  chat.on("history-ready", detail => { if (detail?.available) openEvents(); });
+
   chat.on("connected", retryNow);
   window.addEventListener("online", retryNow);
   document.addEventListener("visibilitychange", () => {
-    if (!document.hidden) { retryNow(); scheduleCallRefresh(); }
+    if (document.hidden) { closeEvents(); return; }
+    retryNow(); scheduleCallRefresh();
+    if (events?.readyState === 2) closeEvents();  // refused (old service / login): try once per return
+    if (events) void refreshRecentRounds(); else openEvents();
   });
   chat.on("timeline-top", loadOlder);
-  chat.on("timeline-latest", () => { paintEdge(); scheduleCallRefresh(); });
+  chat.on("timeline-latest", () => { paintEdge(); scheduleCallRefresh(); void refreshRecentRounds(); });
   chat.on("call-state", detail => { if (detail?.busy === false) scheduleCallRefresh(); });
   chat.on("quote-jump", jumpTo);
   chat.on("jump", jumpTo);
